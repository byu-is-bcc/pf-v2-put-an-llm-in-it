# Secrets. A real secret in git HISTORY is an automatic fail on the
# Portfolio Factory rubric, and deleting the file later does not remove it.
.env
.env.*
!.env.example

# Local database. Regenerated on first run.
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Eval run artifacts you might dump locally
evals/last_run.json
evals/out/

# OS and editor
.DS_Store
.vscode/
.idea/
