# Copy to .env for local overrides. Never commit .env itself.
#
# Default provider is "stub": no account, no network, no key. Fresh clones
# and CI run on the stub. Switch to a real free-tier provider when you are
# ready to measure something true.
#
# Hard constraint for this project: free tier only, no credit card.
# See PROVIDERS.md for what was verified and when.

LLM_PROVIDER=stub
# LLM_PROVIDER=ollama
# LLM_PROVIDER=gemini
# LLM_PROVIDER=groq
# LLM_PROVIDER=openrouter

# Optional. Overrides the provider's default model id.
# LLM_MODEL=

# Only one of these is needed, matching LLM_PROVIDER.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Leave unset for local SQLite (snippets.db). Set a Postgres URL to deploy.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Rate limits and spend caps. Placeholders are deliberately tiny.
# LLM_REQUESTS_PER_MINUTE=5
# LLM_BURST=3
# LLM_DAILY_REQUEST_CAP=50
# LLM_DAILY_TOKEN_CAP=20000

# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_ATTEMPTS=3

# Force a stub failure while testing FAILURE_MODES.md rows:
# LLM_STUB_FAILURE=malformed
# LLM_STUB_FAILURE=truncated
# LLM_STUB_FAILURE=refusal
# LLM_STUB_FAILURE=injected
# LLM_STUB_FAILURE=empty
# LLM_STUB_FAILURE=timeout
# LLM_STUB_FAILURE=ratelimit
